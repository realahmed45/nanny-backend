# ---- Server ----
PORT=4000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated allowed origins for the admin dashboard.
# Leave empty in local dev to allow any origin.
CORS_ORIGINS=

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/mynanny

# ---- Admin auth ----
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@mynanny.com
ADMIN_PASSWORD=admin123

# ---- UltraMsg WhatsApp ----
# From https://user.ultramsg.com  -> your instance
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=your_ultramsg_token
ULTRAMSG_BASE_URL=https://api.ultramsg.com
# Optional shared secret; if set, webhook requests must include ?token=<this>
ULTRAMSG_WEBHOOK_TOKEN=

# ---- Bank details (shown to families for manual transfer) ----
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
# Optional extra line, e.g. "Use your booking ID as the transfer reference."
BANK_INSTRUCTIONS=

# ---- Email: Resend (recommended) ----
# Get a key at https://resend.com/api-keys
# Until you verify your own domain, RESEND_FROM must stay onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM="My Nanny <onboarding@resend.dev>"
# Optional: where replies go. This CAN be a normal inbox (Gmail etc.) —
# only the From address must be on a domain verified in Resend.
RESEND_REPLY_TO=

# ---- Email: SMTP (only if you are not using Resend) ----
# If neither Resend nor SMTP is set, OTP codes are logged, not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My Nanny <no-reply@yourdomain.com>"
# Set to false only if your relay uses a self-signed certificate.
SMTP_REJECT_UNAUTHORIZED=true

# ---- Voice notes (speech-to-text) ----
# Either key enables transcription of WhatsApp voice messages.
# Groq has a free tier and is tried first: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
# Leave empty to auto-detect the spoken language.
TRANSCRIPTION_LANGUAGE=

# ---- Booking limits ----
# How far ahead a booking may start, and how long a recurring one may run.
BOOKING_MAX_START_MONTHS=3
BOOKING_MAX_DURATION_MONTHS=12

# ---- Referrals ----
# Optional short domain for referral links, e.g. https://mynanny.id
# Falls back to PUBLIC_BASE_URL when empty.
REFERRAL_LINK_BASE=
# Shown as typed, so "90k" stays "90k".
REFERRAL_STANDARD_RATE=120k
REFERRAL_DISCOUNTED_RATE=90k

# ---- Business config ----
CURRENCY=IDR
TRANSPORT_FEE_MIN=50000
TRANSPORT_FEE_MAX=100000
NEW_BOOKING_RESPONSE_MINUTES=60
CHANGE_BOOKING_RESPONSE_MINUTES=120
RESCHEDULE_PENALTY_PERCENT=5
FREE_RESCHEDULE_LIMIT=3
LIVE_LOCATION_WINDOW_HOURS=2
